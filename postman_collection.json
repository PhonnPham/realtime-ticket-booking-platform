{
  "info": {
    "name": "Real-Time Event Ticket Booking Platform API",
    "description": "End-to-end API collection for Real-Time Event Ticket Booking Platform featuring Redisson Distributed Locking and RabbitMQ Async Pipeline",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "seatId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "bookingRef",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"phonpham\",\n  \"email\": \"vanphon741@gmail.com\",\n  \"password\": \"SecurePass123!\",\n  \"fullName\": \"Pham Van Phon\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"phonpham\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Events Discovery",
      "item": [
        {
          "name": "Get Upcoming Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/events?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Event Details by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Create Event (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Coldplay Music of the Spheres Stadium Tour\",\n  \"description\": \"Live stadium concert with groundbreaking visual experiences.\",\n  \"venueName\": \"National Stadium\",\n  \"location\": \"Singapore\",\n  \"eventDate\": \"2026-12-15T19:30:00\",\n  \"totalSeats\": 50,\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Seats & Distributed Locking",
      "item": [
        {
          "name": "Get All Seats for Event",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/seats/event/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "seats", "event", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Get Available Seats for Event",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/seats/event/{{eventId}}/available",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "seats", "event", "{{eventId}}", "available"]
            }
          }
        },
        {
          "name": "Hold Seats with Redisson Distributed Lock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"seatIds\": [{{seatId}}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/seats/hold",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "seats", "hold"]
            }
          }
        },
        {
          "name": "Release Held Seats",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[{{seatId}}]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/seats/release",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "seats", "release"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Bookings & Async Queue",
      "item": [
        {
          "name": "Create Booking (Async RabbitMQ Dispatch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.bookingReference) {",
                  "    pm.collectionVariables.set('bookingRef', jsonData.bookingReference);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"seatIds\": [{{seatId}}],\n  \"paymentMethod\": \"CREDIT_CARD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings"]
            }
          }
        },
        {
          "name": "Get User Bookings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/my-bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "my-bookings"]
            }
          }
        },
        {
          "name": "Get Booking by Reference",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{bookingRef}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "{{bookingRef}}"]
            }
          }
        }
      ]
    }
  ]
}
